# ---------------------------------------------------------------------------
# Generated data and models are NOT committed.
#
# Everything under data/processed/ and artifacts/ is reproduced deterministically
# by `python scripts/build_all.py` (~7 min), and the Dockerfile builds it into the
# image. Committing ~25MB of parquet/npy would bloat clone times to save a step
# that is already one command -- and stale artifacts in git are worse than none,
# because artifacts.py would happily serve them against changed code.
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/
.env
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.DS_Store
Thumbs.db

data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# /api/meta reports dataset provenance, so this small file ships too.
!data/processed/data_meta.json
artifacts/*
!artifacts/.gitkeep
# Serving artifacts ARE committed: the deployed function has no build step, so
# it needs the models present. Build-only outputs (item_stats.parquet, the
# evaluation reports) stay ignored -- they are regenerated by build_all.py.
!artifacts/item_vectors.npy
!artifacts/text_encoder.joblib
!artifacts/text_backend.json
!artifacts/item_cooc.npz
!artifacts/als_user_factors.npy
!artifacts/als_item_factors.npy
!artifacts/ranker.joblib
!artifacts/multitask_ranker.joblib
!artifacts/serving_catalog.npz
!artifacts/serving_catalog.json
!artifacts/index_meta.json
!artifacts/evaluation.json
!artifacts/ranker_report.json
!artifacts/intent_evaluation.json
!artifacts/objective_evaluation.json

# local editor/agent config
.claude/
